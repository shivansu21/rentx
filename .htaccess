# Apache configuration for RentX
# Place rentx/ folder inside htdocs/ (XAMPP) or www/ (WAMP)

Options -Indexes
ServerSignature Off

# Protect sensitive files
<FilesMatch "\.(sql|log|md|env|gitignore)$">
    Order Allow,Deny
    Deny from all
</FilesMatch>

# Protect includes directory from direct access
<IfModule mod_rewrite.c>
    RewriteEngine On

    # Block direct access to includes/
    RewriteRule ^includes/ - [F,L]

    # Block direct access to uploads/licences from browser listing
    RewriteRule ^uploads/licences/$ - [F,L]
</IfModule>

# PHP settings (if allowed)
<IfModule mod_php.c>
    php_value upload_max_filesize 25M
    php_value post_max_size 30M
    php_value max_execution_time 60
</IfModule>

# Error pages
ErrorDocument 403 /RentX_Fixed/index.php
ErrorDocument 404 /RentX_Fixed/index.php
